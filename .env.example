# Copy to .env and fill in what you need.
GEMINI_API_KEY=            # default backend (gemini-3.1-pro-preview)
# DEEPSEEK_API_KEY=        # --model deepseek-v4-pro
# OPENAI_API_KEY=          # any OpenAI-compatible model
# OPENAI_BASE_URL=         # e.g. http://localhost:8000/v1 for vLLM
# ECGFOUNDER_REPO=         # clone of github.com/PKUDigitalHealth/ECGFounder
# ECGFOUNDER_CKPT=         # path to 12_lead_ECGFounder.pth
# PAPAGEI_DIR=             # clone of github.com/Nokia-Bell-Labs/papagei-foundation-model
# PAPAGEI_WEIGHTS=         # path to papagei_s.pt
